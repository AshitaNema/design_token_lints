              },
              "helpUri": "https://github.com/AshitaNema/design_token_lints#avoid_raw_color",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "design-system",
                  "color"
                ],
                "precision": "high",
                "problem.severity": "warning"
              }
            },
            {
