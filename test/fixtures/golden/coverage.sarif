          "informationUri": "https://pub.dev/packages/design_token_lints",
          "rules": [
            {
              "id": "avoid_raw_color",
              "name": "avoid_raw_color",
              "shortDescription": {
                "text": "Flags raw colors so that colors come from the design system."
              },
              "fullDescription": {
                "text": "Flags raw colors so that colors come from the design system."
              },
              "help": {
                "text": "See https://github.com/AshitaNema/design_token_lints#avoid_raw_color",
